{
  "name": "@qa/desktop",
  "productName": "Avocado",
  "version": "0.1.1",
  "private": true,
  "description": "AI 보조 모바일 E2E 테스트 데스크톱 앱",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "test:e2e:packaged": "QA_E2E_PACKAGED=1 playwright test e2e/packaged.spec.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.63.0",
    "@qa/agent": "workspace:*",
    "@qa/evidence": "workspace:*",
    "@qa/remote": "workspace:*",
    "@qa/shared": "workspace:*",
    "@qa/workspace": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "7.3.7",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
